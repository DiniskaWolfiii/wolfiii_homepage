---
import background from '../assets/background.svg';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Wolfiii</title>
	</head>
	<body>
		<img id="background" src={background.src} alt="" fetchpriority="high" />
		<slot />
		<Footer />
		<Lightbox />
	</body>
</html>

<style>
	:global(b) {
		font-weight: 700;
	}

	:global(h1) {
		font-family: 'Quicksand', sans-serif;
		font-size: 28px;
		font-weight: 700;
		margin: 20px 0 4px;
	}

	:global(h2) {
		font-family: 'Quicksand', sans-serif;
		font-size: 24px;
		font-weight: 700;
		margin: 10px 0 4px;
	}

	:global(h6) {
		font-size: 7.5px;
		margin: 2px;
	}

	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
	}
	
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-family: 'Quicksand', sans-serif;
	}

	:global(#avatar) {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid rgba(255, 255, 255, 0.15);
	}

	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: border-box;
	}

	:global(#container) {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	:global(main) {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 16px;
	}

	:global(#card) {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 70%;
		max-width: 520px;
		padding: 40px 32px;
		border-radius: 24px;
		background: rgba(20, 22, 27, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(20px);
		text-align: center;
		color: white;
	}

	:global(#links) {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		width: 100%;
	}

	:global(#subtitle) {
		margin: 0 0 24px;
		color: rgba(255, 255, 255, 0.65);
		font-size: 16px;
	}

	:global(.button) {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 10px 20px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: white;
		text-decoration: none;
		font-family: inherit;
		font-size: 18px;
		font-weight: 500;
		cursor: pointer;
		transition:
			background 0.2s,
			border-color 0.2s;
	}

	:global(.button svg),
	:global(.button .icon) {
		width: 20px;
		height: 20px;
		object-fit: contain;
	}

	:global(.button:hover) {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.2);
	}

	:global(#card > .button + .button) {
		margin-top: 12px;
	}

	:global(.divider) {
		width: 100%;
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.403);
		margin: 24px 0 0;
		margin-bottom: 24px;
	}
</style>