---
import profilePicture from '../assets/profilepicture.png';
import twitterIcon from '../assets/icons/twitter.svg?raw';
import githubIcon from '../assets/icons/github.svg?raw';
import discordIcon from '../assets/icons/discord.svg?raw';
import instagramIcon from '../assets/icons/instagram.svg?raw';
import furtrackIcon from '../assets/icons/furtrack.png';
import telegramIcon from '../assets/icons/telegram.svg?raw';
import furaffinityIcon from '../assets/icons/furaffinity.png';
import artIcon from '../assets/icons/art.svg?raw'
import aboutmeIcon from '../assets/icons/aboutme.png';
import folderIcon from './../assets/icons/folder.png'
---

<div id="container">
	<main>
		<div id="card">
			<img id="avatar" src={profilePicture.src} alt="Profile picture" />
			<h1>Awoo! I'm Wolfiii! 👋</h1>
			<p id="subtitle">Your local loud comfort dragon which provides warmth and occacional dad jokes ^^</p>
			<div id="links">
				<a class="button" href="https://x.com/diniskawolfiii" target="_blank" rel="noopener noreferrer"><Fragment set:html={twitterIcon} />Twitter</a>
				<a class="button" href="https://github.com/diniskawolfiii" target="_blank" rel="noopener noreferrer"><Fragment set:html={githubIcon} />GitHub</a>
				<a class="button" href="https://discord.com/users/327880195476422656" target="_blank" rel="noopener noreferrer"><Fragment set:html={discordIcon} />Discord</a>
				<a class="button" href="https://instagram.com/wolfiii.fur" target="_blank" rel="noopener noreferrer"><Fragment set:html={instagramIcon} />Instagram</a>
				<a class="button" href="https://furtrack.com/wolfiii" target="_blank" rel="noopener noreferrer"><img class="icon" src={furtrackIcon.src} />Furtrack</a>
				<a class="button" href="https://t.me/diniskawolfiii" target="_blank" rel="noopener noreferrer"><Fragment set:html={telegramIcon} />Telegram</a>
				<a class="button" href="https://www.furaffinity.net/user/diniskawolfiii" target="_blank" rel="noopener noreferrer"><img class="icon" src={furaffinityIcon.src} />Furaffinity</a>
			</div>
			<hr class="divider" />
			<div id="links">
				<a class="button" href="showcase"><Fragment set:html={artIcon}/>Art showcase</a>
				<a class="button" href="aboutme"><img class="icon" src={aboutmeIcon.src} />About me</a>
				<a class="button" href="stuff"><img class="icon" src={folderIcon.src} />Some stuff</a>
			</div>
		</div>
	</main>
</div>