<div id="lightbox" hidden>
	<button id="lightbox-close" type="button" aria-label="Close">&times;</button>
	<img id="lightbox-image" src="" alt="" hidden />
	<video id="lightbox-video" controls playsinline hidden></video>
</div>

<style>
	#lightbox {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 32px;
		background: rgba(0, 0, 0, 0.85);
	}

	#lightbox[hidden] {
		display: none;
	}

	#lightbox-image,
	#lightbox-video {
		max-width: 100%;
		max-height: 90vh;
		border-radius: 12px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
	}

	#lightbox-close {
		position: absolute;
		top: 24px;
		right: 32px;
		background: none;
		border: none;
		color: white;
		font-size: 32px;
		line-height: 1;
		cursor: pointer;
	}
</style>

<script>
	const lightbox = document.getElementById('lightbox');
	const lightboxImage = document.getElementById('lightbox-image');
	const lightboxVideo = document.getElementById('lightbox-video');
	const closeButton = document.getElementById('lightbox-close');

	function openImage(src: string) {
		if (
			!(lightbox instanceof HTMLElement) ||
			!(lightboxImage instanceof HTMLImageElement) ||
			!(lightboxVideo instanceof HTMLVideoElement)
		) {
			return;
		}
		lightboxVideo.pause();
		lightboxVideo.hidden = true;
		lightboxVideo.removeAttribute('src');
		lightboxImage.src = src;
		lightboxImage.hidden = false;
		lightbox.hidden = false;
	}

	function openVideo(src: string) {
		if (
			!(lightbox instanceof HTMLElement) ||
			!(lightboxImage instanceof HTMLImageElement) ||
			!(lightboxVideo instanceof HTMLVideoElement)
		) {
			return;
		}
		lightboxImage.hidden = true;
		lightboxImage.src = '';
		lightboxVideo.src = src;
		lightboxVideo.hidden = false;
		lightbox.hidden = false;
		lightboxVideo.play();
	}

	function closeLightbox() {
		if (!(lightbox instanceof HTMLElement)) return;
		lightbox.hidden = true;
		if (lightboxVideo instanceof HTMLVideoElement) {
			lightboxVideo.pause();
		}
	}

	document.addEventListener('click', (event) => {
		const trigger = (event.target as HTMLElement).closest('[data-lightbox-src]');
		if (!(trigger instanceof HTMLElement)) return;
		const src = trigger.dataset.lightboxSrc ?? '';
		if (trigger.dataset.lightboxType === 'video') {
			openVideo(src);
		} else {
			openImage(src);
		}
	});

	closeButton?.addEventListener('click', closeLightbox);

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) closeLightbox();
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeLightbox();
	});
</script>
